# gflow clang-tidy configuration.
#
# Philosophy: broad modern-C++ hygiene (bugprone / modernize / performance /
# readability / core-guidelines), with the checks that fight a gRPC + protobuf
# reflection codebase (or are pure noise) disabled. HeaderFilterRegex restricts
# diagnostics to our own headers under src/ — vendored protobuf/grpc/sol2/lua
# and FetchContent build trees are never linted.

Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  misc-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-no-recursion,
  -clang-diagnostic-unused-command-line-argument

# Lint only our own headers, not vendored/generated ones.
HeaderFilterRegex: 'src/.*'

ExtraArgs:
  - '-Qunused-arguments'

# Keep the build green by default; flip to a curated list once the codebase
# settles if you want CI to hard-fail on specific checks.
WarningsAsErrors: ''

FormatStyle: file

CheckOptions:
  - key:   readability-identifier-naming.NamespaceCase
    value: lower_case
  - key:   readability-identifier-naming.ClassCase
    value: CamelCase
  - key:   readability-identifier-naming.StructCase
    value: CamelCase
  - key:   readability-identifier-naming.FunctionCase
    value: camelBack
  - key:   readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key:   readability-braces-around-statements.ShortStatementLines
    value: '1'
